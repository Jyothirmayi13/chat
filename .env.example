# ── Lyzr Agent Studio ──────────────────────────────────────────
LYZR_API_KEY=your-lyzr-api-key-here
# Manager/general agent (required). Called for every step that has no specialist.
LYZR_AGENT_ID=6ac9f92a0754f223eb059fda
# Specialists, each with its own system prompt in Lyzr Studio. Agent ids are
# not secrets (they are useless without the API key). If unset, the manager
# agent above handles that role.
LYZR_GAP_AGENT_ID=6acb298f3ab69773f6536ba2
LYZR_TUTOR_AGENT_ID=6acb299135a2bbbac9f09581
LYZR_VAULT_AGENT_ID=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/

# ── Qdrant vector memory ───────────────────────────────────────
# Local Docker:  http://localhost:6333   (no API key)
# Qdrant Cloud:  https://xyz.cloud.qdrant.io:6333   + API key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Identity ───────────────────────────────────────────────────
# Default user id used by the PWA when Omi uid is not present.
DEFAULT_UID=learner
# Omi rewrites ?uid= with its own account id on every webhook call. Inbound
# /omi/* traffic is pinned to this uid so cards reach the PWA. Leave unset to
# reuse DEFAULT_UID.
OMI_UID=

# ── Omi notifications (closes the loop on the phone) ────────────
# From the Omi developer portal after creating an app. When set, every new
# card from Omi audio is also pushed to the learner's Omi app.
OMI_APP_ID=
OMI_APP_SECRET=

# ── Privacy ──────────────────────────────────────────────────────
# Comma-separated phrases. Any captured chunk containing one of these is
# dropped before it reaches Qdrant or Lyzr. Use it for names, places, or
# anything you never want explained. Leave blank to disable.
DROP_WORDS=
