# ── Lyzr Agent Studio ──────────────────────────────────────────
LYZR_API_KEY=your-lyzr-api-key-here
# Manager/general agent (required). Called for every step that has no specialist.
LYZR_AGENT_ID=6ac9f92a0754f223eb059fda
# Optional specialists. If unset, the manager agent above is used instead.
LYZR_TUTOR_AGENT_ID=
LYZR_GAP_AGENT_ID=
LYZR_VAULT_AGENT_ID=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/

# ── Qdrant vector memory ───────────────────────────────────────
# Local Docker:  http://localhost:6333   (no API key)
# Qdrant Cloud:  https://xyz.cloud.qdrant.io:6333   + API key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Identity ───────────────────────────────────────────────────
# Default user id used by the PWA when Omi uid is not present.
DEFAULT_UID=learner
# Omi rewrites ?uid= with its own account id on every webhook call. Inbound
# /omi/* traffic is pinned to this uid so cards reach the PWA. Leave unset to
# reuse DEFAULT_UID.
OMI_UID=
