{
  "manifest_version": 3,
  "name": "AI Learning Copilot",
  "version": "1.1.0",
  "description": "Your floating AI coach for anything you read in the browser.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "http://localhost:8000/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "http://localhost:8000/*",
        "https://learnloop-xh10.onrender.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}